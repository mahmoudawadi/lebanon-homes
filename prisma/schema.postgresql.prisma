// PostgreSQL schema for production
// To use: Copy this file to schema.prisma when deploying to production
// Or use: DATABASE_URL with postgresql:// protocol

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

